# STONKS Environment Configuration
APP_ENV=dev
LOG_LEVEL=INFO

# Paths (No hardcoded paths in code, resolved relative or absolute)
LOG_DIR=logs
MODEL_DIR=models_data
CACHE_DIR=cache
FEATURE_STORE_DIR=feature_store

# Default parameters
DEFAULT_TICKERS=AAPL,MSFT,GOOGL,TSLA
YFINANCE_PERIOD=2y
YFINANCE_INTERVAL=1d

# Decision thresholds
BUY_THRESHOLD=0.65
SELL_THRESHOLD=0.40

# Ensemble default weights (RF + FinBERT active for Phase 2)
RF_WEIGHT=0.70
LSTM_WEIGHT=0.0
TRANSFORMER_WEIGHT=0.0
FINBERT_WEIGHT=0.30

# Transaction costs
COMMISSION=0.0010
SLIPPAGE=0.0005

# Scheduler settings
SCHEDULER_INTERVAL_HOURS=24
